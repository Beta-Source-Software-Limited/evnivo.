# Copy to .env at project root before docker compose up.
# Local development only: change these before deploying to a public server.
MYSQL_DATABASE=evnivo
MYSQL_USER=evnivo
MYSQL_PASSWORD=local_dev_password
MYSQL_ROOT_PASSWORD=local_root_password
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-before-deployment
DJANGO_DEBUG=True
